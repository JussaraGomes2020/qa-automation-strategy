{
  "name": "desafio-cypress",
  "version": "1.0.0",
  "description": "Projeto de automação de testes Web e API utilizando Cypress, Cucumber e Page Object Model.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:web": "cypress run --spec \"cypress/e2e/**/*.feature\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.js\""
  },
  "keywords": [
    "cypress",
    "qa",
    "automation",
    "bdd",
    "cucumber",
    "javascript",
    "api",
    "page-object"
  ],
  "author": "Jussara Gomes",
  "license": "ISC",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "cypress": "^15.19.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "esbuild": "^0.28.1"
  }
}
